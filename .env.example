# Local PostgreSQL warehouse — the only secret this project currently has.
POSTGRES_USER=merchantmcc
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=merchantmcc
POSTGRES_PORT=55432

# No API keys are listed here because none of the three approved live sources
# (OpenStreetMap Overpass, Frankfurter, GLEIF) require authentication of any kind
# — verified live. If a future source requires a key, its variable name (never
# its value) will be added here as a placeholder.

# Ingestion environment — all optional, each has a safe built-in default.
# See src/ingestion/settings.py for the exact defaults and precedence.
# FINPAY_ENV=local
# FINPAY_REQUEST_TIMEOUT_SECONDS=30
# FINPAY_USER_AGENT=FinPay-Merchant-Intelligence/0.1 (portfolio project; non-commercial; https://github.com/mumairnawaz/MerchantMCC-DE)
# FINPAY_BRONZE_ROOT=data/bronze
# FINPAY_LOG_LEVEL=INFO

# Optional, currently unused — GLEIF requires no key (verified live). Present only
# so a future need would not require a code change. Never set to a fake value.
# GLEIF_API_KEY=
