# Local PostgreSQL warehouse — the only secret this project currently has.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# No API keys are listed here because none of the three approved live sources
# (OpenStreetMap Overpass, Frankfurter, GLEIF) require authentication of any kind
# — verified live. If a future source requires a key, its variable name (never
# its value) will be added here as a placeholder.

# Ingestion environment — all optional, each has a safe built-in default.
# See src/ingestion/settings.py for the exact defaults and precedence.
# FINPAY_ENV=local
# FINPAY_REQUEST_TIMEOUT_SECONDS=30
# FINPAY_USER_AGENT=FinPay-Merchant-Intelligence/0.1 (portfolio project; non-commercial; https://github.com/mumairnawaz/MerchantMCC-DE)
# FINPAY_BRONZE_ROOT=data/bronze
# FINPAY_LOG_LEVEL=INFO

# MerchantMCC-DE's own Airflow metadata database — deliberately separate
# from POSTGRES_* above (that is the application/OLTP database; this is
# only Airflow's internal scheduler/task-history store). Never the same
# instance, per the Airflow Orchestration Audit's explicit requirement.
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=

# Airflow's Fernet key, for encrypting connection passwords/variables at
# rest in its metadata database. Generate one locally with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=

# Airflow 3.x's JWT signing secret — real defect found during DAG first-
# execution testing: this MUST be identical across every component that
# generates or validates task-execution JWTs (scheduler, dag-processor,
# apiserver). Left unset, task launches failed with
# "airflow.sdk.api.client.ServerResponseError: Invalid auth token" even
# though networking/URL config was already correct. Generate one locally
# with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
